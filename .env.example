SECRET_KEY=tu-secret-key-aqui
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,tu-ip-o-dominio
CSRF_TRUSTED_ORIGINS=http://tu-ip-o-dominio

# Postgres compartida con hub y briefs (es lo que habilita el login único)
DATABASE_URL=postgresql://cntxt:cntxt@postgres:5432/cntxt

# Prefijo cuando vive detrás de nginx bajo /propuestas/
FORCE_SCRIPT_NAME=/propuestas

# Opcional: como comparte auth_user con el hub, alcanza con crear el
# superusuario una sola vez (desde cualquiera de los 3 contenedores).
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@cntxt.co
DJANGO_SUPERUSER_PASSWORD=cambia-esta-clave
